# Local PostgreSQL only. Use separate, TLS-verified URLs for each hosted installation.
DATABASE_URL=postgresql://dogbooker:replace-local-password@127.0.0.1:54329/dogbooker
DATABASE_URL_UNPOOLED=postgresql://dogbooker:replace-local-password@127.0.0.1:54329/dogbooker
POSTGRES_PASSWORD=replace-local-password
BETTER_AUTH_SECRET=replace-with-random-secret
BETTER_AUTH_URL=http://localhost:3000
# 0 = unlimited owner/dog pairs; paused accounts count. One dog per owner account.
MAX_OWNERS=0
# Only for disposable databases with synthetic @example.test accounts.
ALLOW_TEST_DATABASE=false
TEST_DATABASE_HOST=127.0.0.1
# Optional email: use YOUR Gmail account/app password, never production credentials in tests.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRON_SECRET=replace-with-random-cron-secret
