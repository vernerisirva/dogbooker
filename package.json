{
  "name": "dogbooker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env.local scripts/run-integration.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "account:admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "format": "prettier --write src scripts tests drizzle *.ts *.mjs *.json *.md",
    "db:seed": "tsx --env-file=.env.local scripts/sample-data.ts",
    "setup": "node scripts/setup-env.mjs",
    "worker": "tsx --env-file=.env.local scripts/run-worker.ts",
    "licenses": "node scripts/licenses.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workflow": "^5.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "zod": "$zod",
    "undici": "^7.30.1",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "type": "module",
  "license": "MIT"
}
